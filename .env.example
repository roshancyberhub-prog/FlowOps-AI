APP_ENV=development
WEB_ORIGIN=http://localhost:3000
POSTGRES_USER=flowops
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=flowops
DATABASE_URL=postgresql+asyncpg://flowops:replace-with-a-local-password@localhost:5432/flowops
REDIS_URL=redis://localhost:6379/0
MAX_STEP_ATTEMPTS=3
EXECUTION_MAX_ACTIVE_SECONDS=600
APPROVAL_TTL_HOURS=72
# Explicit development providers: these make no external AI calls or email sends.
AI_PROVIDER=mock
EMAIL_PROVIDER=mock
# Generate a private value with: python3 scripts/setup-env.py
WEBHOOK_SIGNING_KEY=
# Exact destination hostnames, comma-separated; empty blocks all outgoing webhooks.
WEBHOOK_ALLOWED_HOSTS=

# Optional non-production test-run fault; never affects live mode or production.
DEMO_RETRY_FAILURE=false
